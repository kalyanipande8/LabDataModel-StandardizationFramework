{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "instrument_run.generic.v1",
  "type": "object",
  "required": ["software_version", "run_id_on_instrument", "sample_injection_volume_uL"],
  "properties": {
    "software_version": {"type": "string", "minLength": 1},
    "run_id_on_instrument": {"type": "string", "minLength": 1},
    "sample_injection_volume_uL": {"type": "number", "minimum": 0.1, "maximum": 500},
    "flag": {"type": "string", "enum": ["OK", "REPEAT", "INVALID"]}
  },
  "additionalProperties": false
}
